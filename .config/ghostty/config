# ~/.config/ghostty/config

# Theme configuration
theme = "One Dark Two"

# Font configuration
font-family = "JetBrainsMono Nerd Font"
font-style = Bold
font-size = 11

# Optional: Add a slight padding around the edges so text doesn't touch the window border
window-padding-x = 30
window-padding-y = 30

# Removing Title Bar and Window Decor
# Hide the window titlebar and borders
window-decoration = false
gtk-titlebar = false

# Cursor configuration
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
