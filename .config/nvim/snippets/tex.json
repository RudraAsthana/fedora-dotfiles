  "LaTeX Notes Boilerplate": {
    "prefix": "latex-notes-boilerplate",
    "body": [
      "\\documentclass[12pt,a4paper]{article}",
      "\\usepackage[T1]{fontenc}",
      "\\usepackage{tgbonum}",
      "\\usepackage[scaled=1.3]{newtxmath}",
      "\\usepackage[a4paper,margin=1in]{geometry}",
      "\\usepackage{setspace}",
      "\\onehalfspacing",
      "\\usepackage{amsmath,amssymb}",
      "\\usepackage{siunitx}",
      "\\usepackage{enumitem}",
      "\\usepackage{tikz}",
      "",
      "% Custom title command",
      "\\newcommand{\\customtitle}[2]{%",
      "  \\begin{titlepage}",
      "    \\centering",
      "    \\vspace*{0.28\\textheight}",
      "    {\\Huge\\bfseries #1\\par}",
      "    \\vspace{0.8cm}",
      "    \\rule{0.6\\textwidth}{0.4pt}\\par",
      "    \\vspace{1.2cm}",
      "    {\\Large #2\\par}",
      "    \\vfill",
      "  \\end{titlepage}",
      "}",
      "",
      "\\begin{document}",
      "\\customtitle{${1:Title Here}}{${2:Your Name}}",
      "\\tableofcontents",
      "\\newpage",
      "\\end{document}"
    ],
    "description": "Boilerplate for physics/engineering notes with elegant title page"
  },
  "default": {
    "prefix": "default",
    "body": [
      "\\documentclass[12pt,a4paper]{article}",
      "\\usepackage[utf8]{inputenc}",
      "\\usepackage[T1]{fontenc}",
      "\\usepackage{tgbonum}",
      "\\usepackage[scaled=1.3]{newtxmath}",
      "\\usepackage[a4paper,margin=1in]{geometry}",
      "\\usepackage{setspace}",
      "\\onehalfspacing",
      "\\usepackage{siunitx}",
      "\\usepackage{enumitem}",
      "\\usepackage{tikz}",
      "\\usepackage{csquotes}",
      "\\usepackage[hidelinks]{hyperref}",
      "",
      "% Image Handling Packages",
      "\\usepackage{graphicx}",
      "\\usepackage[export]{adjustbox}",
      "\\usepackage{float}",
      "\\usepackage{tocloft}",
      "",
      "% Adjust Table of Contents spacing",
      "\\setlength{\\cftsecnumwidth}{3.0em}",
      "\\setlength{\\cftsubsecnumwidth}{3.5em}",
      "",
      "% Custom title command",
      "\\newcommand{\\customtitle}[2]{%",
      "  \\begin{titlepage}",
      "    \\centering",
      "    \\vspace*{0.28\\textheight}",
      "    {\\Huge\\bfseries #1\\par}",
      "    \\vspace{0.8cm}",
      "    \\rule{0.6\\textwidth}{0.4pt}\\par",
      "    \\vspace{1.2cm}",
      "    {\\Large #2\\par}",
      "    \\vfill",
      "  \\end{titlepage}",
      "}",
      "",
      "% List formatting configurations",
      "\\setlist[enumerate,1]{label=(\\arabic*), ref=(\\arabic*), leftmargin=*}",
      "\\setlist[enumerate,2]{label=(\\alph*), ref=(\\alph*), leftmargin=*}",
      "",
      "\\begin{document}",
      "",
      "\\customtitle{${1:Basic Structure Doctrine}}{${2:Constitutional Law}}",
      "\\tableofcontents",
      "\\newpage",
      "",
      "\\section{${3:Introduction}}\\label{sec:introduction}",
      "",
      "$0",
      "",
      "\\end{document}"
    ],
    "description": "Default LaTeX notes template with tabbable metadata and custom title variables."
  },
  "note": {
    "prefix": "note",
    "body": [
      "% !TEX program = xelatex",
      "\\documentclass[twoside]{article}",
      "",
      "% Fonts and Typography",
      "\\usepackage{bonum-otf}",
      "\\usepackage{parskip}",
      "",
      "% Page Layout and Margins",
      "\\usepackage[",
      "\tinner=1in,",
      "\touter=3in,",
      "\tmarginparsep=0.25in,",
      "\tmarginparwidth=2.1in,",
      "\ttop=1in,",
      "\tbottom=1in",
      "]{geometry}",
      "\\usepackage{sidenotes}",
      "",
      "% List Formatting",
      "\\usepackage{enumitem}",
      "\\setlist[enumerate,1]{label=(\\arabic*)}",
      "",
      "\\usepackage{tocloft}",
      "\\usepackage{csquotes}",
      "\\usepackage[hidelinks]{hyperref}",
      "",
      "% Adjust Table of Contents spacing",
      "\\setlength{\\cftsecnumwidth}{3.0em}",
      "\\setlength{\\cftsubsecnumwidth}{3.5em}",
      "",
      "\\begin{document}",
      "",
      "\\newgeometry{margin=1in}",
      "\\begin{titlepage}",
      "\t\\begin{center}",
      "\t\t\\vspace*{0.3\\textheight}",
      "\t\t{\\Huge \\bfseries \\MakeUppercase{${1:Comprehensive Legal Reasoning}}\\par}",
      "\t\t\\vspace{1em}",
      "\t\t\\rule{\\linewidth}{0.4pt}",
      "\t\t\\vspace{1.5em}",
      "\t\t{\\Large \\scshape ${2:A Complete Study Manual for Entrance Examinations}\\par}",
      "\t\t\\vspace{3em}",
      "\t\t{\\large \\textbf{Rudra Asthana}\\par}",
      "\t\t\\vfill",
      "\t\\end{center}",
      "\\end{titlepage}",
      "\\restoregeometry",
      "",
      "\\section{${3:First Topic}}",
      "",
      "$0",
      "",
      "\\end{document}"
    ],
    "description": "Custom two-sided layout for study notes with wide margins and a centered title page."
  }
