# 2. Update CSS to wrap code text and eliminate the scrollbar\
cat << 'EOF' > styles.css\
@import url('https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400;0,600;1,400;1,600&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap');\
\
/* Catppuccin Latte (Light Mode Default) */\
:root {\
    --crust: #dce0e8;\
    --mantle: #e6e9ef;\
    --base: #eff1f5;\
    --text: #4c4f69;\
    --subtext0: #6c6f85;\
    --surface0: #ccd0da;\
    --lavender: #7287fd;\
    --blue: #1e66f5;\
    --sapphire: #209fb5;\
    --maroon: #e64553;\
    --mauve: #8839ef;\
    --rosewater: #dc8a78;\
}\
\
/* Catppuccin Mocha (Dark Mode) */\
[data-theme="dark"] {\
    --crust: #11111b;\
    --mantle: #181825;\
    --base: #1e1e2e;\
    --text: #cdd6f4;\
    --subtext0: #a6adc8;\
    --surface0: #313244;\
    --lavender: #b4befe;\
    --blue: #89b4fa;\
    --sapphire: #74c7ec;\
    --maroon: #eba0ac;\
    --mauve: #cba6f7;\
    --rosewater: #f5e0dc;\
}\
\
body {\
    background-color: var(--base);\
    color: var(--text);\
    font-family: "Instrument Sans", -apple-system, sans-serif;\
    font-size: clamp(1.05rem, 1vw + 0.9rem, 1.2rem);\
    line-height: 1.75;\
    margin: 0;\
    padding: 0 1.5rem 4rem 1.5rem;\
    display: grid;\
    grid-template-columns: 1fr min(50ch, 100%) 1fr;\
    overflow-x: hidden;\
    text-rendering: optimizeLegibility;\
    -webkit-font-smoothing: antialiased;\
    font-feature-settings: "kern" 1, "liga" 1, "onum" 1; \
    transition: background-color 0.3s ease, color 0.3s ease;\
}\
\
main { grid-column: 2; position: relative; }\
\
/* Theme Toggle Button */\
.header-nav { display: flex; justify-content: flex-end; padding-top: 1rem; margin-bottom: 1rem; }\
.theme-toggle { background: none; border: none; cursor: pointer; padding: 0.5rem; color: var(--text); opacity: 0.7; transition: opacity 0.3s ease, color 0.3s ease; display: flex; align-items: center; justify-content: center; }\
.theme-toggle:hover { opacity: 1; color: var(--sapphire); }\
.sun-icon { display: none; }\
.moon-icon { display: block; }\
[data-theme="dark"] .sun-icon { display: block; }\
[data-theme="dark"] .moon-icon { display: none; }\
\
/* Typography */\
h1, h2, h3 { font-family: "Instrument Serif", serif; font-weight: 400; color: var(--lavender); text-wrap: balance; margin-top: 2.5em; margin-bottom: 0.75em; }\
h1 { font-size: clamp(3rem, 5vw + 2rem, 4.5rem); margin-top: 0; line-height: 1.1; color: var(--rosewater); letter-spacing: -0.01em; }\
h2 { font-size: 2.2rem; font-style: italic; border-bottom: 1px solid var(--surface0); padding-bottom: 0.3em; color: var(--mauve); }\
h3 { font-size: 1.6rem; color: var(--text); margin-top: 2em; margin-bottom: 0.5em; }\
\
p { margin-top: 0; margin-bottom: 1.5em; text-align: justify; hyphens: auto; }\
a { color: var(--sapphire); text-decoration: none; border-bottom: 1px dotted var(--sapphire); transition: color 0.3s ease; }\
a:hover { color: var(--blue); border-bottom-style: solid; }\
\
blockquote { margin: 2.5rem 0; padding: 1.5rem 2rem; border-left: 3px solid var(--maroon); background: var(--mantle); color: var(--subtext0); font-style: italic; border-radius: 0 8px 8px 0; font-size: 1.1em; }\
ul { padding-left: 1.2em; margin-bottom: 1.5em; }\
li { margin-bottom: 0.6em; }\
li::marker { color: var(--surface0); }\
\
/* Monospaced Code Blocks */\
code, pre { font-family: "JetBrains Mono", monospace; font-size: 0.85em; }\
code { background-color: var(--mantle); padding: 0.2em 0.4em; border-radius: 4px; color: var(--sapphire); }\
pre { \
    background-color: var(--mantle); \
    padding: 1.5rem; \
    border-radius: 8px; \
    margin: 2rem 0; \
    border: 1px solid var(--surface0); \
    line-height: 1.6; \
    white-space: pre-wrap;      /* Forces text to wrap to the next line */\
    word-wrap: break-word;      /* Prevents long strings from breaking out */\
}\
pre code { background-color: transparent; padding: 0; color: var(--text); }\
\
/* Lists & Links */\
.post-list { list-style: none; padding: 0; }\
.post-list li { margin-bottom: 0.8em; }\
.post-meta { color: var(--subtext0); margin-right: 1rem; font-variant-numeric: tabular-nums; }\
.social-links { list-style: none; padding: 0; margin: 2rem 0; display: flex; flex-wrap: wrap; gap: 1.5rem; }\
.social-links li { margin: 0; }\
.social-links a { display: flex; align-items: center; gap: 0.5rem; border: none; color: var(--subtext0); font-size: 0.9em; }\
.social-links a:hover { color: var(--sapphire); }\
.social-links svg { width: 18px; height: 18px; fill: currentColor; }\
.location-tag { text-align: center; font-size: 0.9em; color: var(--subtext0); margin-top: 4rem; font-style: italic; }\
EOF\
\
