# 3. Update existing test posts to use the new layout and remove manual # Headings\
for file in _posts/*/*.md; do\
    if [ -f "$file" ]; then\
        sed -i 's/layout: default/layout: post/g' "$file"\
        # Deletes the line starting with a single hash, removing the manual H1\
        sed -i '/^# /d' "$file" \
    fi\
done\
\
