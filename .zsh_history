bash <<'EOF'\
echo "=== UPTIME / LOAD ==="; uptime\
echo; echo "=== TOP CPU PROCESSES ==="; ps -eo pid,pcpu,pmem,etime,comm --sort=-pcpu | head -15\
echo; echo "=== LEFTOVER BUILD / INDEXING JOBS ==="; pgrep -a 'make|cc1plus|dnf|packagekitd|localsearch|tracker' || echo "none"\
echo; echo "=== MEMORY / SWAP ==="; free -h; swapon --show\
echo; echo "=== DISK ==="; df -h / /home 2>/dev/null\
echo; echo "=== REBOOT NEEDED? ==="; dnf needs-restarting -r 2>&1 | tail -5\
echo; echo "=== KERNEL ==="; uname -r\
echo; echo "=== POWER PROFILE ==="; powerprofilesctl get 2>&1\
echo; echo "=== AC / BATTERY ==="\
for f in /sys/class/power_supply/*; do\
  echo "$(basename "$f"): $(cat "$f/online" 2>/dev/null || true) $(cat "$f/status" 2>/dev/null || true) $(cat "$f/capacity" 2>/dev/null || true)"\
done\
echo; echo "=== CPU CLOCK (MHz) ==="; grep -i "cpu mhz" /proc/cpuinfo | head -8\
echo; echo "=== TEMPERATURES (millidegC) ==="; cat /sys/class/thermal/thermal_zone*/temp 2>/dev/null | head -8\
echo; echo "=== GPU ==="; lspci | grep -iE 'vga|3d|display'\
echo; echo "=== SESSION ==="; echo "$XDG_SESSION_TYPE"\
echo; echo "=== GNOME SETTINGS ==="\
for k in enable-animations text-scaling-factor font-hinting font-antialiasing; do\
  echo "$k: $(gsettings get org.gnome.desktop.interface $k)"\
done\
echo "mutter experimental: $(gsettings get org.gnome.mutter experimental-features)"\
echo; echo "=== RECENT ERRORS (this boot) ==="; journalctl -p err -b --no-pager 2>&1 | tail -15\
EOF
